# Generated Outputs & Packages (Strictly Excluded)
output/
outputs/
ready_to_publish/
temp/
tmp/
.temp/
supabase/.temp/
*.mp4
*.wav
*.mp3

# Logs & OS
*.log
.DS_Store
Thumbs.db

# SQLite & Local Data Stores (Exclude generated stores, keep sample catalog)
data/*.db
data/*.sqlite
data/*.sqlite3
data/velora_store.json

