# =============================================================================
# VELORA AI - AI Fashion Affiliate Engine
# Environment Configuration
# =============================================================================

# --- Supabase Database Configuration ---
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME="Velora AI Studio"

# --- Storage & Output Paths ---
OUTPUT_DIR=./output
PACKAGES_DIR=./ready_to_publish
DATA_DIR=./data

# --- Scoring Parameters ---
SCORE_THRESHOLD=70.0
MIN_STOCK_GATE=10
MIN_COMMISSION_RATE_GATE=0.05
MIN_PRICE_IDR_GATE=25000
